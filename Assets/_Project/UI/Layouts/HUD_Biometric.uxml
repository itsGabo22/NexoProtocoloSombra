<ui:UXML xmlns:ui='UnityEngine.UIElements' editor-extension-mode='False'>
    <Style src='../Styles/tailwind-utilities.uss' />
    <Style src='../Styles/theme-nexo-blue.uss' />
    <Style src='../Styles/theme-hive-red.uss' />
    <Style src='../Styles/nexo-menu-tokens.uss' />
    <Style src='../Styles/components.uss' />

    <ui:VisualElement picking-mode='Ignore' name='hud-root' class='theme-nexo absolute inset-0 pointer-none'>

        <!-- Visión térmica en Built-in (sin Volume URP): primer hijo, los paneles se dibujan encima. La activa ThermalOverlayController -->
        <ui:VisualElement picking-mode='Ignore' name='hud-thermal-overlay' class='thermal-overlay pointer-none' />

        <!-- Feedback de daño: viñeta roja en los bordes (destello al recibir un golpe, pulso lento con salud baja). La controla HUDController -->
        <ui:VisualElement picking-mode='Ignore' name='hud-damage' class='damage-vignette pointer-none' />

        <!-- Columna izquierda: vitales y, 16px debajo, las notificaciones (el flujo flex evita que se solapen a cualquier escala) -->
        <ui:VisualElement picking-mode='Ignore' name='hud-left-column' class='absolute top-4 left-4 flex-col items-start pointer-none'>
            <!-- Vitales (arriba izquierda) -->
            <ui:VisualElement picking-mode='Ignore' name='hud-vitals' class='hud-panel w-64 flex-col p-3 pointer-none'>
                <ui:Label text='ESTADO BIOMÉTRICO' class='text-xs text-muted tracking-wide' />
                <ui:Label name='hud-vitals-value' text='100% ILESO' class='text-xl text-ok font-bold mt-1' />
                <!-- La mentira del HUD: siempre «NO INFECTADO» hasta que el giro final lo sustituye -->
                <ui:Label name='hud-vitals-infection' text='NO INFECTADO' class='hud-vitals-infection text-sm text-ok font-bold tracking-wide' />
                <ui:Label name='hud-vitals-status' text='VIDA 3/3 · GOLPES 0/4' class='text-sm text-main mt-1' />
                <ui:Label name='hud-bpm' text='♥ 72 BPM' class='text-xs text-muted mt-2' />
            </ui:VisualElement>

            <!-- Capa de notificaciones (reales y falsas): HUDController añade aquí las tarjetas -->
            <ui:VisualElement picking-mode='Ignore' name='hud-notifications' class='hud-notifications-stack flex-col items-start mt-4 pointer-none' />
        </ui:VisualElement>

        <!-- Radio / videollamada de Elena (arriba derecha) -->
        <ui:VisualElement name='hud-radio' class='hud-panel absolute top-4 right-4 w-80 flex-col p-3'>
            <ui:VisualElement class='flex-row items-center'>
                <ui:VisualElement name='radio-elena-portrait' class='radio-portrait emotion-calm w-16 h-16 mr-2' />
                <ui:VisualElement class='flex-col grow'>
                    <ui:Label text='ELENA · CANAL SEGURO' class='text-sm text-accent font-bold tracking-wide' />
                    <ui:Label name='radio-seal' text='✔ BIO-ID VERIFICADO' class='hud-seal text-xs' />
                    <ui:Label name='radio-emotion' text='CALMA' class='text-xs text-muted' />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class='radio-trust-track mt-2'>
                <ui:VisualElement name='radio-trust-fill' class='radio-trust-fill' />
            </ui:VisualElement>
            <ui:Label name='radio-typing' text='Elena está escribiendo…' class='hidden text-xs text-muted font-italic mt-2' />
            <ui:Label name='radio-dialogue' text='' class='text-sm text-main wrap mt-2' />
            <ui:Label name='radio-ai-marker' text='' picking-mode='Ignore' class='hidden text-xs text-muted mt-1' />
            <ui:Label name='radio-voice-status' text='' picking-mode='Ignore' class='hidden text-xs text-main mt-1' />
            <ui:VisualElement class='flex-col mt-2'>
                <ui:Button name='radio-quick-1' focusable='false' text='[1] ¿Está despejado el pasillo?' class='btn-quick mb-1' />
                <ui:Button name='radio-quick-2' focusable='false' text='[2] Abre la puerta de las escaleras' class='btn-quick mb-1' />
                <ui:Button name='radio-quick-3' focusable='false' text='[3] Tengo miedo, ¿qué tienes en la mano?' class='btn-quick' />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Espectrograma de ruido (abajo izquierda) -->
        <ui:VisualElement picking-mode='Ignore' name='hud-noise' class='hud-panel absolute bottom-4 left-4 w-64 flex-col p-3 pointer-none'>
            <ui:VisualElement class='flex-row justify-between'>
                <ui:Label text='RUIDO' class='text-xs text-muted tracking-wide' />
                <ui:Label name='hud-noise-value' text='0' class='text-xs text-accent' />
            </ui:VisualElement>
            <ui:VisualElement name='hud-spectrogram' class='spectrogram flex-row items-end h-16 mt-1' />
        </ui:VisualElement>

        <!-- Columna inferior derecha: arma encima de la batería térmica (el flujo flex evita solapes a cualquier escala) -->
        <ui:VisualElement picking-mode='Ignore' name='hud-right-column' class='absolute bottom-4 right-4 flex-col items-end pointer-none'>
            <!-- Arma y munición: oculto hasta el primer GameEvents.OnAmmoChanged -->
            <ui:VisualElement picking-mode='Ignore' name='hud-weapon' class='hud-panel hud-weapon hidden w-64 flex-col p-3 mb-2 pointer-none'>
                <ui:VisualElement class='flex-row items-center justify-between'>
                    <ui:Label name='hud-weapon-name' text='M1911' class='text-xs text-muted tracking-wide' />
                    <ui:Label name='hud-weapon-pickup' text='' class='hud-weapon__pickup text-sm text-ok font-bold' />
                </ui:VisualElement>
                <ui:VisualElement class='flex-row items-end mt-1'>
                    <ui:Label name='hud-weapon-ammo' text='2 / 0' class='hud-weapon__ammo text-2xl font-bold' />
                    <ui:Label name='hud-weapon-status' text='' class='hud-weapon__status text-xs font-bold tracking-wide ml-2 mb-1' />
                </ui:VisualElement>
                <!-- Celdas del cargador: las crea HUDController según el tamaño del cargador -->
                <ui:VisualElement picking-mode='Ignore' name='hud-weapon-cells' class='flex-row mt-2 pointer-none' />
            </ui:VisualElement>

            <!-- Batería de visión térmica -->
            <ui:VisualElement picking-mode='Ignore' name='hud-battery' class='hud-panel w-64 flex-col p-3 pointer-none'>
                <ui:VisualElement class='flex-row justify-between'>
                    <ui:Label text='VISIÓN TÉRMICA' class='text-xs text-muted tracking-wide' />
                    <ui:VisualElement class='flex-row'>
                        <ui:Label name='hud-battery-state' text='APAGADA' class='text-xs text-muted mr-2' />
                        <ui:Label name='hud-battery-value' text='100%' class='text-xs text-accent' />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class='battery-track mt-1'>
                    <ui:VisualElement name='hud-battery-fill' class='battery-fill' />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Ayuda de controles: una vez por sesión al empezar a jugar (arriba al centro, entre vitales y radio) -->
        <ui:Label picking-mode='Ignore' name='hud-controls-hint' text='' class='hud-controls-hint hidden absolute text-sm text-main pointer-none' />

        <!-- Centro libre: mira y prompt de interacción -->
        <ui:VisualElement picking-mode='Ignore' name='hud-crosshair' class='crosshair absolute pointer-none' />
        <ui:Label picking-mode='Ignore' name='hud-interact' text='' class='hud-interact-prompt hidden absolute text-sm text-main pointer-none' />

        <!-- Plot twist: destello, panel ROOT DEBUG -->
        <!-- Pantalla de captura: la muestra HUDController con OnPlayerCaught y la oculta al recargar el piso -->
        <ui:VisualElement picking-mode='Ignore' name='hud-capture' class='hud-capture hidden absolute inset-0 flex-col items-center justify-center pointer-none'>
            <ui:Label text='SEÑAL VITAL PERDIDA' class='text-3xl text-danger font-bold tracking-wider' />
            <ui:Label name='hud-capture-floor' text='Reiniciando protocolo del Piso 12...' class='text-base text-muted mt-2' />
        </ui:VisualElement>

        <ui:VisualElement picking-mode='Ignore' name='hud-glitch' class='glitch-overlay absolute inset-0 pointer-none' />
        <ui:VisualElement picking-mode='Ignore' name='hud-debug' class='root-debug hidden absolute inset-0 flex-col justify-center p-8 pointer-none'>
            <ui:Label text='NEXOOS v4.2 // MODO DEPURACIÓN ROOT' class='text-lg text-danger font-bold tracking-wider mb-4' />
            <ui:Label name='hud-debug-text' text='' class='text-base text-main wrap' />
        </ui:VisualElement>

        <!-- Subtítulos (último hijo: se dibujan sobre el panel ROOT DEBUG) -->
        <ui:Label picking-mode='Ignore' name='hud-subtitles' text='' class='subtitles absolute bottom-4 text-base text-main text-center wrap pointer-none' />
    </ui:VisualElement>
</ui:UXML>
