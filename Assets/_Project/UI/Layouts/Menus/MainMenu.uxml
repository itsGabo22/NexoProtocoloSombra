<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../../Styles/nexo-menu-tokens.uss" />
    <Style src="../../Styles/nexo-start-menu.uss" />

    <!-- Menú principal (estilo monocromo salvia/carbón, solo texto). Fondo, viñeta, franja y grano: MenuBackdrop.
         Los nombres mm-root, mm-item-* y mm-hint los usa MainMenuController. -->
    <ui:VisualElement name="mm-root" class="aw-screen">
        <ui:VisualElement name="aw-bg" picking-mode="Ignore" class="aw-bg" />
        <ui:VisualElement name="aw-vignette" picking-mode="Ignore" class="aw-vignette" />

        <ui:VisualElement name="mm-title-block" picking-mode="Ignore" class="aw-title-block">
            <ui:VisualElement picking-mode="Ignore" class="aw-hairline" />
            <ui:VisualElement name="aw-strip" picking-mode="Ignore" class="aw-strip" />
            <ui:Label name="mm-brand" text="NEXO" picking-mode="Ignore" class="aw-title" />
            <ui:Label name="mm-subtitle" text="PROTOCOLO SOMBRA" picking-mode="Ignore" class="aw-subtitle" />
            <ui:VisualElement picking-mode="Ignore" class="aw-hairline" />
            <ui:Label name="mm-tagline" text="TORRE NEXOCORP · PISO 12 · NEXOOS V4.2" picking-mode="Ignore" class="aw-tagline" />
        </ui:VisualElement>

        <ui:VisualElement name="mm-list" class="aw-menu">
            <ui:Label name="mm-item-play" text="NUEVA PARTIDA" class="aw-item is-focused" />
            <ui:Label name="mm-item-options" text="OPCIONES" class="aw-item" />
            <ui:Label name="mm-item-credits" text="CRÉDITOS" class="aw-item" />
            <ui:Label name="mm-item-quit" text="SALIR" class="aw-item" />
        </ui:VisualElement>

        <ui:Label name="mm-hint" text="Inicia el protocolo en el Piso 12." picking-mode="Ignore" class="aw-hint" />
        <ui:Label name="mm-footer" text="W S / ↑ ↓  MOVER     ENTER  CONFIRMAR     RATÓN  ELEGIR" picking-mode="Ignore" class="aw-footer" />
        <ui:Label name="mm-version" text="NEXOOS V4.2" picking-mode="Ignore" class="aw-version" />

        <ui:VisualElement name="aw-grain" picking-mode="Ignore" class="aw-grain" />
    </ui:VisualElement>
</ui:UXML>
