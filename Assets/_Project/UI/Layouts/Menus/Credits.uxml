<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../../Styles/theme-nexo-blue.uss" />
    <Style src="../../Styles/theme-hive-red.uss" />
    <Style src="../../Styles/components.uss" />
    <Style src="../../Styles/nexo-menu-tokens.uss" />
    <Style src="../../Styles/nexo-menu-components.uss" />
    <Style src="../../Styles/tailwind-utilities.uss" />
    <Style src="../../Styles/nexo-menu-screens.uss" />
    <ui:Template name="NxPanel" src="../Components/NxPanel.uxml" />
    <ui:Template name="NxKeyHint" src="../Components/NxKeyHint.uxml" />

    <!-- Pantalla 10: Créditos, tema hive (spec §6.10). Sin elementos enfocables: Esc vuelve al menú. -->
    <ui:VisualElement name="cr-root" class="theme-hive nx-screen">
        <ui:Label name="cr-mode" text="MODO DEPURACIÓN ROOT" class="cr-mode label text-accent" />
        <ui:Label name="cr-title" text="CRÉDITOS" class="cr-title title text-main" />

        <ui:Instance template="NxPanel" name="cr-bio-panel" class="nx-bio-panel">
            <ui:AttributeOverrides element-name="panel-label" text="ESTADO BIOMÉTRICO" />
            <ui:Label name="cr-bio-value" text="98.4% INFECTADO" class="readout text-main" />
            <ui:Label name="cr-bio-status" text="FASE TERMINAL" class="body-sm text-muted" />
        </ui:Instance>

        <!-- Dos columnas para que todos los créditos verificados quepan en 1080 px sin desplazamiento -->
        <ui:VisualElement name="cr-block" class="cr-block">
            <ui:VisualElement name="cr-col-left" class="cr-col">
                <ui:Label name="cr-design-label" text="DISEÑO Y DESARROLLO" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-design-value" text="Gabriel Esteban Paz Guerrero · Carlos Julian Benavides Burbano" class="body text-main wrap nx-mb-24" />
                <ui:Label name="cr-course-label" text="MATERIA" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-course-value" text="Diseño de Interfaces · Ingeniería de Software, 5.º semestre" class="body text-main wrap nx-mb-24" />
                <ui:Label name="cr-dialogue-label" text="DIÁLOGOS DE ELENA" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-dialogue-value" text="Gemini 2.5 Flash (Google)" class="body text-main wrap nx-mb-24" />
                <ui:Label name="cr-fonts-label" text="TIPOGRAFÍAS" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-fonts-value" text="Barlow Condensed (The Barlow Project Authors) · IBM Plex Sans e IBM Plex Mono (IBM Corp.) · SIL Open Font License 1.1" class="body text-main wrap nx-mb-24" />
                <ui:Label name="cr-audio-label" text="EFECTOS DE SONIDO" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-audio-value" text="Sonido procedural creado para el proyecto" class="body text-main wrap nx-mb-24" />
            </ui:VisualElement>
            <ui:VisualElement name="cr-col-right" class="cr-col">
                <ui:Label name="cr-weapon-label" text="ARMA M1911" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-weapon-value" text="Nokobot, Modern Guns · Handgun v1.2 (Unity Asset Store) · Standard Unity Asset Store EULA" class="body text-main wrap nx-mb-24" />
                <ui:Label name="cr-character-label" text="PERSONAJE Y ANIMACIONES" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-character-value" text="Mixamo (Adobe)" class="body text-main wrap nx-mb-24" />
                <ui:Label name="cr-locomotion-label" text="ANIMACIONES DE LOCOMOCIÓN" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-locomotion-value" text="Starter Assets, plantilla de Unity Learn (Unity Technologies) · Unity Companion License" class="body text-main wrap nx-mb-24" />
                <ui:Label name="cr-building-label" text="EDIFICIO DE OFICINAS Y ENTORNO" class="label text-muted nx-mb-4" />
                <ui:Label name="cr-building-value" text="Polygon Office Building (Unity Asset Store) · Standard Unity Asset Store EULA" class="body text-main wrap nx-mb-24" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="cr-hint" text="Vuelve al menú principal." class="nx-hint body text-muted" />

        <ui:VisualElement name="cr-keyhints" picking-mode="Ignore" class="nx-keyhints">
            <ui:Instance template="NxKeyHint" name="cr-key-back">
                <ui:AttributeOverrides element-name="keyhint-key" text="Esc" />
                <ui:AttributeOverrides element-name="keyhint-action" text="Atrás" />
            </ui:Instance>
        </ui:VisualElement>

        <ui:Label name="cr-version" text="NEXOOS V4.2" class="nx-version label text-muted" />
    </ui:VisualElement>
</ui:UXML>
