<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../../Styles/nexo-menu-tokens.uss" />
    <Style src="../../Styles/nexo-start-menu.uss" />

    <!-- Pantalla de inicio «PRESIONA [ENTER] PARA CONTINUAR» (sustituye a la antigua animación de despertar).
         Intro, cualquier tecla o clic → menú principal (BootSequenceController en modo splash: existe splash-prompt). -->
    <ui:VisualElement name="boot-root" class="aw-screen">
        <ui:VisualElement name="aw-bg" picking-mode="Ignore" class="aw-bg" />
        <ui:VisualElement name="aw-vignette" picking-mode="Ignore" class="aw-vignette" />

        <ui:VisualElement name="splash-title-block" picking-mode="Ignore" class="aw-title-block">
            <ui:VisualElement picking-mode="Ignore" class="aw-hairline" />
            <ui:VisualElement name="aw-strip" picking-mode="Ignore" class="aw-strip" />
            <ui:Label text="NEXO" picking-mode="Ignore" class="aw-title" />
            <ui:Label text="PROTOCOLO SOMBRA" picking-mode="Ignore" class="aw-subtitle" />
            <ui:VisualElement picking-mode="Ignore" class="aw-hairline" />
            <ui:Label text="UN JUEGO DE TERROR CON IA · EQUIPO NEXO" picking-mode="Ignore" class="aw-tagline" />
        </ui:VisualElement>

        <ui:Label name="splash-prompt" text="PRESIONA [ENTER] PARA CONTINUAR" picking-mode="Ignore" class="aw-prompt" />
        <ui:Label name="splash-footer" text="SE RECOMIENDAN AURICULARES · MICRÓFONO OPCIONAL PARA HABLAR CON ELENA [V]" picking-mode="Ignore" class="aw-footer" />

        <ui:VisualElement name="aw-grain" picking-mode="Ignore" class="aw-grain" />
    </ui:VisualElement>
</ui:UXML>
