/* Assets/_Project/UI/Styles/components.uss */
.hud-panel {
    background-color: var(--c-surface);
    border-color: var(--c-accent);
    border-width: 1px;
    border-radius: 6px;
}
.a11y-hc .hud-panel { border-width: 2px; }

.hud-seal { color: var(--c-ok); }
.hud-seal--hidden { display: none; }

/* Retrato de Elena por emoción */
.radio-portrait { background-color: var(--c-bg); border-width: 2px; border-radius: 999px; border-color: var(--c-accent); transition-property: scale, border-color; transition-duration: 300ms; }
.radio-portrait.pulse-on { scale: 1.06 1.06; }
.emotion-calm { border-color: var(--c-accent); }
.emotion-happy { border-color: var(--c-ok); }
.emotion-scared { border-color: var(--c-warn); }
.emotion-urgent { border-color: var(--c-danger); }
.emotion-sad { border-color: var(--c-muted); }
.emotion-whisper { border-color: var(--c-muted); opacity: 0.8; }
/* Retrato real (Resources/Elena/portrait.png): recorte circular por border-radius; el borde de emoción se mantiene */
.radio-portrait--image { -unity-background-scale-mode: scale-and-crop; }

.radio-trust-track { height: 4px; background-color: var(--c-accent-dim); border-radius: 2px; }
.radio-trust-fill { height: 100%; width: 0; background-color: var(--c-accent); border-radius: 2px; transition-property: width; transition-duration: 400ms; }

/* Botones rápidos con foco visible (WCAG 2.4.7) */
.btn-quick { -unity-text-align: middle-left; font-size: 13px; color: var(--c-text); background-color: var(--c-accent-dim); border-color: var(--c-accent); border-width: 1px; border-radius: 4px; padding: 6px 8px; margin: 0; }
.btn-quick:hover { background-color: var(--c-accent); color: var(--c-bg); }
.btn-quick:focus { border-width: 2px; border-color: var(--c-warn); }
.btn-quick:disabled { opacity: 0.4; }

/* Espectrograma y batería */
.spectrogram-bar { width: 6px; margin-right: 2px; height: 4%; background-color: var(--c-accent); border-radius: 1px; }
.spectrogram.noise-high .spectrogram-bar { background-color: var(--c-danger); }
.battery-track { height: 8px; background-color: var(--c-accent-dim); border-radius: 4px; }
.battery-fill { height: 100%; width: 100%; background-color: var(--c-accent); border-radius: 4px; }
.battery-fill.low { background-color: var(--c-danger); }

/* Prompt [E] centrado 24px bajo la mira (sin posición quedaba en la esquina superior izquierda, sobre los vitales) */
.hud-interact-prompt { left: 50%; top: 50%; translate: -50% 0; margin-top: 24px; white-space: nowrap; }

/* Mira */
.crosshair { left: 50%; top: 50%; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px; border-radius: 3px; background-color: var(--c-text); opacity: 0.7; }

/* Notificaciones: estado base oculto, .hud-notification--visible las muestra */
.hud-notification { width: 360px; margin-bottom: 8px; padding: 10px 12px; background-color: var(--c-surface); border-color: var(--c-accent); border-width: 1px; border-radius: 6px; opacity: 0; translate: 0 -12px; transition-property: opacity, translate, scale, border-color; transition-duration: 250ms; }
.hud-notification--visible { opacity: 1; translate: 0 0; }
/* Notificación repetida: no se apila, la tarjeta existente late una vez (HUDController no lo aplica con reducir movimiento) */
.hud-notification.hud-notification--pulse { scale: 1.02 1.02; border-color: var(--c-text); }
/* Pila bajo los vitales: tope de altura para no alcanzar el panel de ruido (abajo izquierda) a 100/125/150 %;
   si hay demasiadas tarjetas se recortan las más antiguas (arriba) y las nuevas siguen visibles */
.hud-notifications-stack { max-height: 720px; overflow: hidden; justify-content: flex-end; }
.hud-notifications-stack > .hud-notification { flex-shrink: 0; }

/* Mensaje FALSO (Mimicry): 4 anomalías sutiles, ninguna depende solo del color */
.hud-notification--fake { border-color: var(--c-fake); letter-spacing: 3px; -unity-font-style: italic; rotate: -0.6deg; }
.hud-notification--fake .hud-notification__sender { color: var(--c-fake); }
/* Para la tipografía alterada, añadir cuando exista el archivo:
   -unity-font: url('../Fonts/HudGlitch.ttf'); */

.wave-bar { width: 4px; margin-right: 2px; background-color: var(--c-accent); border-radius: 1px; }
.hud-notification--fake .wave-bar { background-color: var(--c-fake); }

/* Subtítulos centrados */
.subtitles { left: 20%; right: 20%; padding: 6px 12px; background-color: var(--c-surface); border-radius: 4px; }

/* Plot twist */
.glitch-overlay { background-color: rgba(255, 59, 59, 0); transition-property: background-color; transition-duration: 60ms; }
.glitch-overlay.hud-glitch-critical { background-color: rgba(255, 59, 59, 0.28); }

.hud-shattered-a { translate: -60px -40px; rotate: -9deg; opacity: 0; transition-property: translate, rotate, opacity; transition-duration: 700ms; }
.hud-shattered-b { translate: 70px 30px; rotate: 11deg; opacity: 0; transition-property: translate, rotate, opacity; transition-duration: 700ms; }
.hud-shattered-c { translate: 0 90px; rotate: 4deg; opacity: 0; transition-property: translate, rotate, opacity; transition-duration: 700ms; }

.root-debug { background-color: rgba(10, 0, 2, 0.92); }
.hud-infected-mode .hud-panel { border-color: var(--c-danger); }

/* ---------- Terminal de seguridad ---------- */
.terminal-overlay { background-color: rgba(0, 0, 0, 0.6); }
.terminal-window { width: 900px; }
.terminal-feeds { flex-grow: 1; }
.terminal-feed { width: 256px; margin-right: 8px; margin-bottom: 8px; border-color: var(--c-accent); border-width: 1px; border-radius: 4px; overflow: hidden; }
.terminal-feed__image { width: 256px; height: 144px; background-color: var(--c-bg); -unity-background-scale-mode: scale-to-fit; }
.terminal-feed__label { font-size: 11px; color: var(--c-accent); padding: 2px 6px; background-color: var(--c-surface); }
.terminal-doors { width: 280px; }
.terminal-door { flex-direction: row; align-items: center; justify-content: space-between; padding: 6px 8px; margin-bottom: 6px; border-color: var(--c-accent-dim); border-width: 1px; border-radius: 4px; }
.terminal-door__state { font-size: 11px; color: var(--c-muted); }
.terminal-door--open .terminal-door__state { color: var(--c-ok); }
.terminal-door--locked .terminal-door__state { color: var(--c-danger); }
.terminal-door__button { width: 90px; }
/* Una sola cámara: la vista previa ocupa el ancho libre de la columna (16:9) en lugar de dejar un hueco */
.terminal-feeds--single .terminal-feed { width: 100%; margin-right: 0; }
.terminal-feeds--single .terminal-feed__image { width: 100%; height: 320px; }

/* ---------- Rueda de órdenes ---------- */
.order-wheel-overlay { background-color: rgba(0, 0, 0, 0.35); align-items: center; justify-content: center; }
.order-wheel-ring { width: 420px; height: 420px; border-radius: 210px; border-width: 2px; border-color: var(--c-accent-dim); background-color: var(--c-surface); }
.order-wheel-center { position: absolute; left: 150px; top: 150px; width: 120px; height: 120px; border-radius: 60px; border-width: 1px; border-color: var(--c-accent); background-color: var(--c-bg); -unity-text-align: middle-center; white-space: normal; font-size: 13px; color: var(--c-text); }
.order-sector { position: absolute; width: 112px; height: 80px; margin-left: -56px; margin-top: -40px; align-items: center; justify-content: center; border-radius: 8px; border-width: 1px; border-color: rgba(0, 0, 0, 0); transition-property: scale, background-color, border-color; transition-duration: 120ms; }
.order-sector__icon { width: 32px; height: 32px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--c-accent); }
.order-sector__label { font-size: 13px; color: var(--c-text); -unity-text-align: middle-center; white-space: normal; margin-top: 4px; }
.order-sector--selected { scale: 1.1 1.1; background-color: var(--c-accent-dim); border-color: var(--c-accent); }
.order-sector--selected .order-sector__label { color: var(--c-accent); -unity-font-style: bold; }

/* ---------- Pantalla de captura ---------- */
.hud-capture { background-color: rgba(10, 0, 2, 0.85); opacity: 0; transition-property: opacity; transition-duration: 400ms; }
.hud-capture--visible { opacity: 1; }

/* ---------- Ruta segura (HIGHLIGHT_SAFE_ROUTE) ---------- */
.crosshair { transition-property: scale, background-color, opacity; transition-duration: 250ms; }
.crosshair.crosshair--route { background-color: var(--c-ok); opacity: 1; scale: 1.8 1.8; }

/* ---------- Interferencia de transmisión (glitch_intensity) ---------- */
.glitch-overlay.hud-glitch-pulse { background-color: rgba(34, 211, 238, 0.16); }

/* Visión térmica sin URP (pipeline Built-in): tinte cian + viñeta a pantalla completa bajo los paneles del HUD */
.thermal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(34, 211, 238, 0.14);
    background-image: url("../Textures/T_ThermalVignette.png");
    -unity-background-image-tint-color: rgba(2, 24, 36, 0.9);
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 250ms;
}

.thermal-overlay.thermal-on { opacity: 1; }
.a11y-hc .thermal-overlay { background-color: rgba(34, 211, 238, 0.08); }

/* ---------- Panel de arma y munición (abajo derecha, sobre la batería térmica) ---------- */
.hud-weapon { transition-property: border-color, scale; transition-duration: 250ms; }
.hud-weapon__ammo { color: var(--c-text); }
.hud-weapon__status { color: var(--c-muted); }
.hud-weapon__pickup { opacity: 0; transition-property: opacity; transition-duration: 300ms; }
.hud-weapon__pickup.hud-weapon__pickup--visible { opacity: 1; }
.hud-weapon-cell { width: 18px; height: 8px; margin-right: 4px; border-width: 1px; border-color: var(--c-accent); border-radius: 1px; background-color: rgba(0, 0, 0, 0); }
.hud-weapon-cell--filled { background-color: var(--c-accent); }
/* Estados: además del color cambian el texto (RECARGAR [R], SIN MUNICIÓN), así no dependen solo del color */
.hud-weapon--low .hud-weapon__ammo, .hud-weapon--low .hud-weapon__status { color: var(--c-warn); }
.hud-weapon--low .hud-weapon-cell { border-color: var(--c-warn); }
.hud-weapon--low .hud-weapon-cell--filled { background-color: var(--c-warn); }
.hud-weapon--empty, .hud-weapon--depleted { border-color: var(--c-danger); }
.hud-weapon--empty .hud-weapon__ammo, .hud-weapon--empty .hud-weapon__status,
.hud-weapon--depleted .hud-weapon__ammo, .hud-weapon--depleted .hud-weapon__status { color: var(--c-danger); }
.hud-weapon--empty .hud-weapon-cell, .hud-weapon--depleted .hud-weapon-cell { border-color: var(--c-danger); }
/* Vacío: la etiqueta pasa a «chip» rojo con texto oscuro; así se distingue del ámbar de MUNICIÓN BAJA aunque los tonos se parezcan (hive, daltonismo) */
.hud-weapon--empty .hud-weapon__status, .hud-weapon--depleted .hud-weapon__status { color: var(--c-bg); background-color: var(--c-danger); padding: 1px 6px; border-radius: 2px; }
.a11y-hc .hud-weapon--empty, .a11y-hc .hud-weapon--depleted { border-width: 3px; }
.hud-weapon--reloading .hud-weapon__ammo { color: var(--c-muted); }
.hud-weapon--reloading .hud-weapon__status { color: var(--c-accent); }
/* Pulso breve al recoger munición (HUDController no lo aplica con reducir movimiento) */
.hud-weapon.hud-weapon--pulse { border-color: var(--c-ok); scale: 1.04 1.04; }

/* ---------- Feedback de daño: viñeta roja en los bordes ---------- */
.damage-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../Textures/T_ThermalVignette.png");
    -unity-background-image-tint-color: var(--c-danger);
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 220ms;
}
.damage-vignette.damage-vignette--low { opacity: 0.3; transition-duration: 900ms; }
.damage-vignette.damage-vignette--low-peak { opacity: 0.55; transition-duration: 900ms; }
.damage-vignette.damage-vignette--hit { opacity: 0.9; transition-duration: 60ms; }

/* ---------- Ayuda de controles (una vez por sesión) ---------- */
.hud-controls-hint { left: 50%; top: 16px; translate: -50% 0; padding: 6px 14px; white-space: nowrap; background-color: var(--c-surface); border-color: var(--c-accent-dim); border-width: 1px; border-radius: 4px; opacity: 0; transition-property: opacity; transition-duration: 400ms; }
.hud-controls-hint.hud-controls-hint--visible { opacity: 1; }
.a11y-hc .hud-controls-hint { border-color: var(--c-text); }
