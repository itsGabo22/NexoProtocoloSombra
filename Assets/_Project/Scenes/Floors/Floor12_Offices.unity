  m_Name: 
  m_EditorClassIdentifier: Nexo::Nexo.Interaction.StorySequence
  _mode: 1
  _doorId: 
  _requires: {fileID: 563760675}
  _lines:
  - Speaker: 4
    Text: (La interfaz se apaga. Silencio absoluto)
    Delay: 0
    Emotion: calm
    Glitch: 0
    Action: 3
    ActionParam: 
  - Speaker: 6
    Text: "NEXO OS \u2014 ERROR DE IDENTIDAD \xB7 Usuario: Alex \xB7 Estado: no reconocido \xB7 Protocolo Sombra: activo."
    Delay: 3
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: Alex... escucha.
    Delay: 4
    Emotion: whisper
    Glitch: 0.7
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: Lo que viste en el piso 12 no fue el comienzo.
    Delay: 3
    Emotion: whisper
    Glitch: 0.5
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: Fue el lugar donde dejamos de tener el control.
    Delay: 3.5
    Emotion: whisper
    Glitch: 0.5
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "En el piso 6... no conf\xEDes en todo lo que escuches."
    Delay: 3.5
    Emotion: whisper
    Glitch: 0.8
    Action: 0
    ActionParam: 
  - Speaker: 5
    Text: Baja por la escalera de emergencia [E].
    Delay: 2.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
