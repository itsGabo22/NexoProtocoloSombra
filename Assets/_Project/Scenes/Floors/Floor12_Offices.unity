--- !u!114 &1380507742
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1380507741}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6812dc0b454044fb8a28b327957afd68, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Nexo::Nexo.Interaction.StorySequence
  _mode: 0
  _doorId: 
  _requires: {fileID: 0}
  _lines:
  - Speaker: 1
    Text: "NEXO OS \u2014 SISTEMA DE RECUPERACI\xD3N \xB7 Identidad: no verificada \xB7 Estado del edificio: cr\xEDtico."
    Delay: 1.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 1
    Text: "Personal registrado: 0 \xB7 Conexi\xF3n con el servidor central: interrumpida."
    Delay: 3.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "\xBFPuedes escucharme?"
    Delay: 3.5
    Emotion: whisper
    Glitch: 0.3
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "No te muevas todav\xEDa. Necesito comprobar que eres t\xFA."
    Delay: 3
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "...Bien. Est\xE1s vivo."
    Delay: 4
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Soy Elena, la asistente del edificio. El piso 12 est\xE1 en cuarentena y la salida segura est\xE1 bloqueada."
    Delay: 3.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Llega a la sala de servidores. All\xED podr\xE9 ayudarte."
    Delay: 5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 5
    Text: "Llega a la sala de servidores (suroeste). Ag\xE1chate [C] para no ser visto. Mant\xE9n [V] para hablar con Elena."
    Delay: 3
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  _doorsToLock: []
  _audioSource: {fileID: 0}
  _clip: {fileID: 0}
  _alarmObjects: []
  _elenaAnimator: {fileID: 0}
  _elenaCompanion: {fileID: 0}
  _elenaExitPoint: {fileID: 0}
