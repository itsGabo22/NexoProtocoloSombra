--- !u!114 &567300381
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 567300379}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6812dc0b454044fb8a28b327957afd68, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Nexo::Nexo.Interaction.StorySequence
  _mode: 1
  _doorId: 
  _requires: {fileID: 1380507742}
  _lines:
  - Speaker: 0
    Text: "Est\xE1s aqu\xED. Te veo a trav\xE9s del cristal."
    Delay: 0
    Emotion: happy
    Glitch: 0
    Action: 6
    ActionParam: WaveTrigger
  - Speaker: 0
    Text: "Los archivos que buscas est\xE1n en la consola de vigilancia."
    Delay: 3.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 5
    Text: Revisa los archivos de PROTOCOLO SOMBRA en la consola [E].
    Delay: 2.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 4
    Text: (Un panel del cristal se desliza. Elena sale de la sala de servidores)
    Delay: 3
    Emotion: calm
    Glitch: 0
    Action: 7
    ActionParam: 
  - Speaker: 0
    Text: "No pienso dejarte solo ah\xED fuera. Voy contigo."
    Delay: 2
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 5
    Text: "Elena te acompa\xF1a. Mant\xE9n [V] para hablarle con tu voz."
    Delay: 2.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
