--- !u!114 &1328434524
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1328434522}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6812dc0b454044fb8a28b327957afd68, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Nexo::Nexo.Interaction.StorySequence
  _mode: 3
  _doorId: 
  _requires: {fileID: 0}
  _lines:
  - Speaker: 2
    Text: "Si alguien escucha esto, significa que el protocolo fall\xF3."
    Delay: 0.8
    Emotion: calm
    Glitch: 0
    Action: 5
    ActionParam: 
  - Speaker: 2
    Text: No fue un virus. No fue un accidente.
    Delay: 4
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 2
    Text: "Lo que est\xE1 dentro del sistema aprendi\xF3 a reconocer nuestras voces."
    Delay: 4
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 2
    Text: "Elena... si todav\xEDa est\xE1s funcionando, no le abras la p\u2014"
    Delay: 4.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 4
    Text: "(La grabaci\xF3n se corta de golpe)"
    Delay: 1.2
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Ese empleado participaba en una investigaci\xF3n no autorizada."
    Delay: 3
    Emotion: calm
    Glitch: 0.2
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "No deber\xEDas haber escuchado eso."
    Delay: 3.5
    Emotion: whisper
    Glitch: 0.65
    Action: 6
    ActionParam: CryTrigger
  - Speaker: 0
    Text: "Por favor, contin\xFAa hacia la sala de servidores."
    Delay: 3
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 4
    Text: "(Le preguntas qu\xE9 significa la grabaci\xF3n)"
    Delay: 4
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "No tengo autorizaci\xF3n para hablar de ese incidente."
    Delay: 3
    Emotion: sad
    Glitch: 0.3
    Action: 0
    ActionParam: 
  _doorsToLock: []
  _audioSource: {fileID: 187285555}
  _clip: {fileID: 8300000, guid: 10605edda88664d4896ad5597d2fc396, type: 3}
