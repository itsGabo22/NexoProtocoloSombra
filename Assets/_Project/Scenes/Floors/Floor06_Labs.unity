  _mode: 1
  _doorId: 
  _requires: {fileID: 0}
  _lines:
  - Speaker: 6
    Text: Error de sensor externo ignorado por filtro NexoOS.
    Delay: 0.1
    Emotion: calm
    Glitch: 0.4
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Se fue la luz. No corras, Alex. Pulsa F y mira por d\xF3nde vas."
    Delay: 2.4
    Emotion: WHISPER
    Glitch: 0
    Action: 4
    ActionParam: 
  - Speaker: 3
    Text: "Alex, estoy aqu\xED. Ven, r\xE1pido. Apaga la linterna, as\xED no nos ven."
    Delay: 5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: Esa no soy yo. Sigue conmigo.
    Delay: 2.5
    Emotion: URGENT
    Glitch: 0
    Action: 0
    ActionParam: 
