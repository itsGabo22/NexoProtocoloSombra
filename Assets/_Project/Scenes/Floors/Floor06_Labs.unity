  m_Script: {fileID: 11500000, guid: 6812dc0b454044fb8a28b327957afd68, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Nexo::Nexo.Interaction.StorySequence
  _mode: 1
  _doorId: 
  _requires: {fileID: 0}
  _lines:
  - Speaker: 6
    Text: Error de sensor externo ignorado por filtro NexoOS.
    Delay: 0.1
    Emotion: calm
    Glitch: 0.4
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Se fue la luz. No corras, Alex. Pulsa F y mira por d\xF3nde vas."
    Delay: 2.4
    Emotion: WHISPER
    Glitch: 0
    Action: 4
    ActionParam: 
  - Speaker: 3
    Text: "Alex, estoy aqu\xED. Ven, r\xE1pido. Apaga la linterna, as\xED no nos ven."
    Delay: 5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 4
    Text: (Una voz como la de Elena llama desde la oscuridad)
    Delay: 0.3
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: Esa no soy yo. Sigue conmigo.
    Delay: 2.5
    Emotion: URGENT
    Glitch: 0
    Action: 0
    ActionParam: 
  _doorsToLock: []
  _audioSource: {fileID: 1149152478}
  _clip: {fileID: 8300000, guid: f81775010a01d8e468e0ee8677ef8e8a, type: 3}
