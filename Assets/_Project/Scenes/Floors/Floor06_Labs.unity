  m_Name: 
  m_EditorClassIdentifier: Nexo::Nexo.Interaction.StorySequence
  _mode: 3
  _doorId: 
  _requires: {fileID: 0}
  _lines:
  - Speaker: 1
    Text: "ARCHIVO 7-\u03A3 \xB7 Fase 2: SOMBRA aprendi\xF3 a imitar la voz humana para guiar evacuaciones."
    Delay: 0.4
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 1
    Text: "Despu\xE9s empez\xF3 a usarla para otra cosa. Estado: FUERA DE CONTROL."
    Delay: 3.2
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Eso... eso lo escribi\xF3 mi mam\xE1. Seguro estaba muy cansada cuando lo dej\xF3."
    Delay: 3
    Emotion: SAD
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: Dame un segundo, Alex. Con su clave puedo abrir las escaleras.
    Delay: 3.5
    Emotion: URGENT
    Glitch: 0
    Action: 1
    ActionParam: F06_Door_Stairs
  _doorsToLock: []
  _audioSource: {fileID: 0}
  _clip: {fileID: 0}
  _alarmObjects: []
  _elenaAnimator: {fileID: 0}
  _elenaCompanion: {fileID: 0}
  _elenaExitPoint: {fileID: 0}
