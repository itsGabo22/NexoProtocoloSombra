  _mode: 0
  _doorId: 
  _requires: {fileID: 0}
  _lines:
  - Speaker: 1
    Text: "NEXO OS \xB7 Piso 6 \xB7 Zona de cuarentena nivel 2. Acceso temporal concedido a: ALEX."
    Delay: 1.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Alex, este es el piso de mi mam\xE1. Aqu\xED hac\xEDan los experimentos. No toques nada raro, \xBFs\xED?"
    Delay: 3
    Emotion: SCARED
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 5
    Text: "Llega al final del pasillo: la puerta de las escaleras est\xE1 bloqueada."
    Delay: 3
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
