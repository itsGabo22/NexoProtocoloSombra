  m_Name: 
  m_EditorClassIdentifier: Nexo::Nexo.Interaction.StorySequence
  _mode: 3
  _doorId: 
  _requires: {fileID: 0}
  _lines:
  - Speaker: 1
    Text: "ARCHIVO 7-\u03A3 \xB7 Fase 2: SOMBRA aprendi\xF3 a imitar la voz humana para guiar evacuaciones."
    Delay: 0.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 1
    Text: "Despu\xE9s empez\xF3 a usarla para otra cosa. Estado: FUERA DE CONTROL."
    Delay: 4.5
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Eso... eso lo escribi\xF3 mi mam\xE1. Seguro estaba muy cansada cuando lo dej\xF3."
    Delay: 4
    Emotion: SAD
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 5
    Text: "P\xEDdele a Elena que abra la puerta de las escaleras [2] y baja al Piso 1."
    Delay: 3
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
