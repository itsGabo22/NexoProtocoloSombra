  m_Name: 
  m_EditorClassIdentifier: Nexo::Nexo.Interaction.StorySequence
  _mode: 2
  _doorId: F06_Door_Stairs
  _requires: {fileID: 0}
  _lines:
  - Speaker: 0
    Text: "Espera, espera... \xA1ya! Te abr\xED la puerta de las escaleras. Corre antes de que vuelvan a cerrarla."
    Delay: 1.2
    Emotion: URGENT
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Yo bajo por el ascensor de servicio con la tarjeta de mam\xE1. Nos vemos en el vest\xEDbulo, \xBFs\xED?"
    Delay: 4.5
    Emotion: CALM
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 5
    Text: Baja por las escaleras del este del pasillo [E].
    Delay: 3
    Emotion: calm
    Glitch: 0
    Action: 0
    ActionParam: 
