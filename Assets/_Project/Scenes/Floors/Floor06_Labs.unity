    Emotion: URGENT
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 0
    Text: "Yo bajo por el ascensor de servicio con la tarjeta de mam\xE1. Nos vemos en el vest\xEDbulo, \xBFs\xED?"
    Delay: 4.5
    Emotion: CALM
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 5
    Text: Baja por las escaleras del este del pasillo [E].
    Delay: 3
    Emotion: calm
