    Text: "Yo bajo por el ascensor de servicio con la tarjeta de mam\xE1. Nos vemos en el vest\xEDbulo, \xBFs\xED?"
    Delay: 4
    Emotion: WHISPER
    Glitch: 0
    Action: 0
    ActionParam: 
  - Speaker: 5
